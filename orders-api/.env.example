# Porta HTTP da API
PORT=3000

# Conexao com o mesmo banco "marketplace" alimentado pelo pubsub-consumer (Java).
# Aceita URL no formato postgres:// (o prefixo jdbc: eventualmente usado no
# projeto Java e removido automaticamente se vier assim).
DB_URL=postgresql://localhost:5432/marketplace
DB_USER=marketplace_app
DB_PASSWORD=mkt_2025_app

# Tamanho maximo do pool de conexoes
DB_POOL_MAX=10

# Paginacao
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
